# Stable UUID for the Tempo tenant. Generate once with: uuidgen
# Keep this value unchanged for the lifetime of TempoStack/mesh.
TEMPO_TENANT_ID=

# Space-separated namespaces whose Envoy gateways/waypoints must be scraped.
MESH_NAMESPACES="istio-system bookinfo"

TEMPO_NAMESPACE=tempo
TEMPO_OBC_NAME=tempo-odf
TEMPO_STORAGE_SECRET=tempostack-odf

# Red Hat's documented internal ODF S3 endpoint for Tempo.
TEMPO_S3_ENDPOINT=https://s3.openshift-storage.svc

# On a fresh OCP 5.0 AWS cluster, opt in to installing the ODF operator and
# standalone NooBaa MCG with a PV-backed gp3-csi store before core validation.
# Keep disabled on an already installed cluster; can also run bootstrap-mcg.sh.
BOOTSTRAP_MCG=0
# Do not consider only OBC API/StorageClass existence as proof of healthy MCG.
CHECK_MCG_HEALTH=1
MCG_TIMEOUT_SECONDS=1200

# Core apply preserves an existing healthy Istio 1.31 mesh by default.
# Version-family override for nonstandard installed operators or preserved Istio.
# Use the CLI --relax-version-checks instead of enabling persistently.
RELAX_VERSION_CHECKS=0

APPLY_MESH_BASE=0

# OpenShift Service Mesh Console (OSSMC) is part of the default stack and
# provides the Service Mesh navigation in the OpenShift web console.
ENABLE_MESH_CONSOLE=1

# OpenShift distributed tracing UI is part of the default v3.5 stack.
# Set 0 only when intentionally deploying without the console tracing plugin.
ENABLE_TRACING_UI=1

# If enabled, grant system:authenticated read access to tenant "mesh".
# Keep 0 and customize optional/15-tempo-console-reader-rbac.yaml for tighter RBAC.
ENABLE_TRACING_UI_RBAC=0

# Optional override. When empty/unset, render.sh discovers the OpenShift console Route.
# OPENSHIFT_CONSOLE_URL=https://console-openshift-console.apps.example.com

# Bookinfo is part of the supported setup and final E2E path by default.
DEPLOY_BOOKINFO=1
RUN_E2E=1

# Final E2E controls. TRACE_TEST_URL is normally auto-discovered from the
# bookinfo/istio-ingressgateway Route; set it only to override that endpoint.
E2E_REQUESTS=200
E2E_FORCED_TRACES=12
E2E_TRACE_WAIT_SECONDS=180
E2E_MAX_HTTP_FAILURES=0
E2E_MIN_RANDOM_TRACES=5
E2E_MIN_METRIC_DELTA=100
TEMPO_LOCAL_PORT=18080
THANOS_LOCAL_PORT=19091
# TRACE_TEST_URL=http://bookinfo.example.com/productpage

# Per-API-call timeout used by readiness/validation helpers.
KUBE_API_REQUEST_TIMEOUT=15s
