# Stable UUID for the Tempo tenant. Generate once with: uuidgen
TEMPO_TENANT_ID=

# Space-separated namespaces whose Istio sidecars must be scraped by UWM.
MESH_NAMESPACES="istio-system bookinfo"

TEMPO_NAMESPACE=tempo
TEMPO_OBC_NAME=tempo-odf
TEMPO_STORAGE_SECRET=tempostack-odf
# TEMPO_S3_ENDPOINT=https://s3.openshift-storage.svc
