# Stable UUID for the Tempo tenant. Generate once with: uuidgen
# Keep this value unchanged for the lifetime of TempoStack/mesh.
TEMPO_TENANT_ID=

# Space-separated mesh namespaces whose Istio sidecars must be scraped by UWM.
MESH_NAMESPACES="istio-system bookinfo"

TEMPO_NAMESPACE=tempo
TEMPO_OBC_NAME=tempo-odf
TEMPO_STORAGE_SECRET=tempostack-odf

# Red Hat's documented internal ODF S3 endpoint for Tempo.
TEMPO_S3_ENDPOINT=https://s3.openshift-storage.svc

# Core apply preserves an existing healthy v1.30.3 mesh by default.
APPLY_MESH_BASE=0

# OpenShift distributed tracing UI is part of the default v3.4 stack.
# Set 0 only when intentionally deploying without the console tracing plugin.
ENABLE_TRACING_UI=1

# If enabled, grant system:authenticated read access to tenant "mesh".
# Keep 0 and customize optional/15-tempo-console-reader-rbac.yaml for tighter RBAC.
ENABLE_TRACING_UI_RBAC=0

# Optional override. When empty/unset, render.sh discovers the OpenShift console Route.
# OPENSHIFT_CONSOLE_URL=https://console-openshift-console.apps.example.com
