# Schema-only template. Do not populate or commit real credentials.
# storage/odf/create-tempo-secret.sh creates this Secret directly from the
# ObjectBucketClaim-generated ConfigMap and Secret without writing credentials
# to the repository.
apiVersion: v1
kind: Secret
metadata:
  name: __TEMPO_STORAGE_SECRET__
  namespace: __TEMPO_NAMESPACE__
type: Opaque
stringData:
  bucket: __BUCKET_NAME__
  endpoint: __TEMPO_S3_ENDPOINT__
  access_key_id: __AWS_ACCESS_KEY_ID__
  access_key_secret: __AWS_SECRET_ACCESS_KEY__
