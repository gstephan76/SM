apiVersion: kiali.io/v1alpha1
kind: Kiali
metadata:
  name: kiali
  namespace: istio-system
spec:
  auth:
    strategy: openshift
  deployment:
    logger:
      log_level: info
    view_only_mode: false
  external_services:
    grafana:
      enabled: false
    prometheus:
      url: https://thanos-querier.openshift-monitoring.svc.cluster.local:9091
      auth:
        type: bearer
        use_kiali_token: true
      thanos_proxy:
        enabled: true
    tracing:
      enabled: true
      provider: tempo
      use_grpc: false
      namespace_selector: true
      internal_url: https://tempo-mesh-gateway.tempo.svc.cluster.local:8080/api/traces/v1/mesh/tempo
      external_url: __OPENSHIFT_CONSOLE_URL__
      tempo_config:
        name: mesh
        namespace: tempo
        tenant: mesh
        url_format: openshift
      auth:
        type: bearer
        use_kiali_token: true
        insecure_skip_verify: false
  istio_namespace: istio-system
  version: default
