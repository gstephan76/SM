apiVersion: tempo.grafana.com/v1alpha1
kind: TempoStack
metadata:
  name: mesh
  namespace: tempo
spec:
  managementState: Managed
  storage:
    secret:
      name: tempostack-odf
      type: s3
  tenants:
    authentication:
    - tenantId: __TEMPO_TENANT_ID__
      tenantName: mesh
    mode: openshift
  template:
    gateway:
      enabled: true
      rbac:
        enabled: true
    queryFrontend:
      jaegerQuery:
        enabled: false
